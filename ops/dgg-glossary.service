[Unit]
Description=Build the live DGG chat glossary (dgg-chat-site)
After=network-online.target

[Service]
Type=oneshot
# Holds ANTHROPIC_API_KEY=...; create it yourself, chmod 600. Without it, new terms publish as "definition pending".
EnvironmentFile=-%h/.config/socialscope/anthropic.env
ExecStart=/usr/bin/python3 -I /home/probs/dgg-chat-site/site/build_glossary.py --out /home/probs/dgg-chat-site-pages/data
